# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.firstquant.in

# Enquiry form: email delivery (recommended).
# Put real values in .env.local (git-ignored) and in your host's environment settings.
# For Gmail: SMTP_USER is the Gmail address that sends, SMTP_PASS is a Gmail
# "app password" (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives every enquiry
ENQUIRY_TO=

# Optional: also forward each enquiry as JSON (Slack/Make/Zapier webhook or a CRM endpoint).
ENQUIRY_WEBHOOK_URL=

# In production, if neither email nor webhook is configured, the form shows an
# error instead of pretending to send.
